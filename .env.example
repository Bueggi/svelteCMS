# Database
# Optional: if DATABASE_URL / BETTER_AUTH_SECRET are not set, the /setup wizard asks for the
# database and generates the secret, storing both in data/config.json (override the path with
# CONFIG_FILE). Environment variables always take precedence over that file.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Setup wizard protection (production only). The wizard is locked behind a token that is
# printed to the server log while setup is open. Set SETUP_TOKEN to choose your own
# (use a long random value); otherwise a random one is generated on every start.
# SETUP_TOKEN=""
# CONFIG_FILE="data/config.json"

# adapter-node rejects request bodies over 512 KB by default; image uploads allow up to 8 MB.
# (Already set in the Docker image.)
# BODY_SIZE_LIMIT="12M"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Test Keys (Sandbox mode for funnel testing)
STRIPE_TEST_SECRET_KEY=""
STRIPE_TEST_PUBLISHABLE_KEY=""

# OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# SMTP (optional — for email verification, password reset)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# ── Auto-Update System ────────────────────────────────────────────────────────
# Prüft ob eine neuere Version verfügbar ist und zeigt dem Admin ein Banner.
# Nur Commits bei denen latest.json versioniert wird lösen ein Update aus.
UPDATE_CHECK_URL="https://raw.githubusercontent.com/Bueggi/svelteCMS/master/latest.json"
